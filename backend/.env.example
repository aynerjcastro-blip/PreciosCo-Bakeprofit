# Copia este archivo a ".env" y llena los valores. NUNCA subas el ".env".
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

GOOGLE_CLIENT_ID=
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=

APP_PREMIUM_PRICE=

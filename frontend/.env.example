# Variables de entorno requeridas para el frontend
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Copia este archivo como backend/.env y completa los valores localmente.
# Nunca subas backend/.env a Git.

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SPRING_JPA_HIBERNATE_DDL_AUTO=validate

JWT_SECRET=
JWT_EXPIRATION=86400000


MAIL_ENABLED=false
MAIL_FROM=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

STAGING_ENABLED=false